# ⚠️ NOTA: Variáveis de ambiente abaixo são apenas para o servidor HTTP (src/yt.ts)
# Para o Apify Actor (src/main.ts), o usuário envia a API key via input do actor
# Não é necessário arquivo .env para publicar na Apify

PORT=6969
AUTH_BEARER_KEY=change-me
OPENROUTER_API_KEY=change-me
OPENROUTER_MODEL=openai/whisper-large-v3
