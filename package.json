{
  "name": "youtube-transcriber",
  "version": "2.0.0",
  "description": "Apify actor that extracts transcripts from YouTube videos with Whisper AI fallback",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts --env-file=.env",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "apify",
    "actor",
    "youtube",
    "transcript",
    "whisper"
  ],
  "license": "ISC",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "apify": "^3.1.0",
    "undici": "^6.0.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^2.0.0"
  }
}
