{
  "name": "youtube-transcript-wrapper",
  "version": "1.0.0",
  "description": "Apify actor that wraps the YouTube transcript scraper for easy transcript extraction",
  "main": "src/main.ts",
  "scripts": {
    "start": "node --loader=tsx ./src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "keywords": [
    "apify",
    "actor",
    "youtube",
    "transcript",
    "scraper"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "apify": "^3.1.0",
    "apify-client": "^2.23.3",
    "dotenv": "^17.4.2",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
