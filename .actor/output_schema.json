{
  "title": "YouTube Transcriber Output",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "youtubeUrl": { "type": "string" },
    "videoId": { "type": "string" },
    "transcript": { "type": "string" },
    "provider": {
      "type": "string",
      "enum": ["youtube-transcript", "openrouter"]
    },
    "language": { "type": "string" },
    "usage": { "type": "object" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "error": { "type": "string" },
    "details": { "type": "string" }
  },
  "required": ["success", "youtubeUrl", "generatedAt"]
}
