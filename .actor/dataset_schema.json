{
  "fields": {
    "youtubeUrl": {
      "description": "The YouTube video URL",
      "type": "string",
      "example": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
    },
    "videoId": {
      "description": "YouTube video ID",
      "type": "string",
      "example": "dQw4w9WgXcQ"
    },
    "transcript": {
      "description": "Full transcribed text from the video",
      "type": "string",
      "example": "Never gonna give you up, never gonna let you down..."
    },
    "provider": {
      "description": "Source of the transcript",
      "type": "string",
      "enum": ["youtube-transcript", "openrouter"],
      "example": "youtube-transcript"
    },
    "language": {
      "description": "Detected language of the transcript",
      "type": "string",
      "example": "en"
    },
    "success": {
      "description": "Whether transcription was successful",
      "type": "boolean",
      "example": true
    },
    "generatedAt": {
      "description": "ISO timestamp when transcript was generated",
      "type": "string",
      "example": "2026-05-26T13:30:00.000Z"
    }
  }
}
